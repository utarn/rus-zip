<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>RusZip.Desktop</RootNamespace>
    <ApplicationIcon>Assets/rus-zip.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- ProDataGrid is the MIT-licensed continuation of Avalonia.Controls.TreeDataGrid
         (same original author, wieslawsoltes). The TreeDataGrid 11.2+ line went commercial
         (Avalonia Pro license, AvaloniaUI.Licensing build gate), so this is the drop-in
         replacement for the archive browser. See issue #51 / docs. -->
    <PackageReference Include="ProDataGrid" />
    <!-- ProCharts.Avalonia is the MIT-licensed real-time charting control used by the
         progress overlay velocity chart (issue #59). The chart model (ProCharts.*) is a
         pure .NET model layer; only the ProChartView control pulls in Avalonia.Skia +
         SkiaSharp. All chart work stays in RusZip.Desktop — Core and CLI stay headless. -->
    <PackageReference Include="ProCharts.Avalonia" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Transitive pin: resolves GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959) for Tmds.DBus.Protocol,
         pulled in transitively via Avalonia.Desktop -> Avalonia.FreeDesktop (12.1.1 -> 0.94.1).
         Advisory patched in 0.21.3 (backport) and >= 0.92.0 (mainline); 0.94.1 is the lowest
         version that satisfies the resolved graph AND clears the advisory.
         https://github.com/advisories/GHSA-xrw6-gwf8-vvr9 -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusZip.Core\RusZip.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

</Project>
