<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>RusZip.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.20" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.20" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.20" />
    <!-- ProDataGrid 11.3.x is the MIT-licensed continuation of Avalonia.Controls.TreeDataGrid
         (same original author, wieslawsoltes). The TreeDataGrid 11.2+ line went commercial
         (Avalonia Pro license, AvaloniaUI.Licensing build gate), so this is the drop-in
         replacement for the archive browser. See issue #51 / docs. -->
    <PackageReference Include="ProDataGrid" Version="11.3.11" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Transitive pin: resolves GHSA-xrw6-gwf8-vvr9 (CVE-2026-39959) for Tmds.DBus.Protocol,
         pulled in transitively via Avalonia.Desktop -> Avalonia.FreeDesktop (0.20.0).
         Advisory patched in 0.21.3 (backport) and >= 0.92.0; 0.21.3 is the lowest patched version.
         https://github.com/advisories/GHSA-xrw6-gwf8-vvr9 -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusZip.Core\RusZip.Core.csproj" />
  </ItemGroup>

</Project>
