<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        x:Class="RusZip.Desktop.Views.FileConflictDialog"
        x:DataType="vm:FileConflictViewModel"
        Title="File Conflict - RUS ZIP"
        Width="540" Height="380"
        MinWidth="500" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="Full"
        Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Alert}"
                          Width="18" Height="18"
                          Foreground="#E5A00D" />
                <TextBlock Text="File Already Exists"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Conflict Content -->
        <ScrollViewer Grid.Row="1" Padding="20,16">
            <StackPanel Spacing="16">
                <!-- Explanatory message & Target Path -->
                <TextBlock Text="A file with the same name already exists in the destination folder:"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           TextWrapping="Wrap"
                           FontSize="13" />

                <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding RelativePath}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DirectoryPath}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Comparison Cards Grid -->
                <Grid ColumnDefinitions="*,*">
                    <!-- Existing File Card -->
                    <Border Grid.Column="0"
                            Margin="0,0,6,0"
                            Background="{DynamicResource CardBackgroundFillColorDefault}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Existing File (On Disk)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondary}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ExistingFileSizeFormatted}" FontWeight="Medium" FontSize="12" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExistingLastModifiedFormatted}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Incoming File Card -->
                    <Border Grid.Column="1"
                            Margin="6,0,0,0"
                            Background="{DynamicResource CardBackgroundFillColorDefault}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Incoming File (Archive)"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondary}" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Size:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,0,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IncomingFileSizeFormatted}" FontWeight="Medium" FontSize="12" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Modified:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,0,8,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IncomingLastModifiedFormatted}" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Toolbar -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Abort Button -->
                <Button Grid.Column="0"
                        Command="{Binding AbortCommand}"
                        Content="Cancel"
                        Padding="14,6" />

                <!-- Action Buttons: Skip, Skip All, Overwrite, Overwrite All -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SkipCommand}"
                            Content="Skip"
                            Padding="12,6" />
                    <Button Command="{Binding SkipAllCommand}"
                            Content="Skip All"
                            Padding="12,6" />
                    <Button Command="{Binding OverwriteCommand}"
                            Content="Overwrite"
                            Padding="12,6" />
                    <Button Command="{Binding OverwriteAllCommand}"
                            Content="Overwrite All"
                            Padding="12,6" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
