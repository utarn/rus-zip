<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             xmlns:models="using:RusZip.Desktop.Models"
             x:Class="RusZip.Desktop.Views.CompressionSettingsView"
             x:DataType="vm:CompressionSettingsViewModel">

    <StackPanel Spacing="12" Margin="16">
        <!-- Staged Sources Tree Header & Summary Metrics -->
        <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Staged Files &amp; Folders:" FontWeight="SemiBold" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="{Binding TotalFilesCount, StringFormat='{}Files: {0:N0}'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiary}" />
                <TextBlock Text="{Binding ExcludedFilesCount, StringFormat='{}Excluded: {0:N0}'}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorTertiary}" />
                <TextBlock Text="{Binding FormattedTotalStagedBytes, StringFormat='{}Total Size: {0}'}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Staging Toolbar & DataGrid -->
        <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorSecondary}"
                Padding="0">
            <Grid RowDefinitions="Auto,*">
                <!-- Toolbar -->
                <Border Grid.Row="0"
                        Padding="8,6"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="0,0,0,1"
                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding AddFilesCommand}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTip.Tip="Add files to stage">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource Icon.NewArchive}" Width="12" Height="12" />
                                    <TextBlock Text="Add File(s)..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding AddFolderCommand}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTip.Tip="Add directory folder to stage">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="12" Height="12" />
                                    <TextBlock Text="Add Folder..." VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding RemoveSelectedCommand}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTip.Tip="Un-stage root item or exclude selected child">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                                    <TextBlock Text="Remove / Exclude" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleExclusionCommand}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTip.Tip="Toggle exclusion of selected item">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12" />
                                    <TextBlock Text="Toggle Exclusion" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding ClearAllCommand}"
                                    Padding="8,4"
                                    FontSize="12"
                                    ToolTip.Tip="Clear all staged items">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <PathIcon Data="{StaticResource Icon.Clear}" Width="12" Height="12" />
                                    <TextBlock Text="Clear All" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hierarchical DataGrid -->
                <DataGrid x:Name="StagedGrid"
                          Grid.Row="1"
                          Height="160"
                          HierarchicalRowsEnabled="True"
                          HierarchicalModel="{Binding GridSource}"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          SelectedItem="{Binding SelectedItem}">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Toggle Exclusion" Command="{Binding ToggleExclusionCommand}" />
                            <MenuItem Header="Remove / Exclude Selected" Command="{Binding RemoveSelectedCommand}" />
                            <MenuItem Header="Clear All" Command="{Binding ClearAllCommand}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridHierarchicalColumn Header="Name"
                                                    Width="*"
                                                    CanUserSort="True"
                                                    CanUserResize="True"
                                                    SortMemberPath="Name"
                                                    x:CompileBindings="False"
                                                    Binding="{Binding Item}">
                            <DataGridHierarchicalColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding !IsExcluded}"
                                                  Margin="0,0,4,0"
                                                  VerticalAlignment="Center"
                                                  ToolTip.Tip="Check to include in archive, uncheck to exclude" />
                                        <PathIcon Data="{Binding IconGeometry}" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Opacity="{Binding IsExcluded, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridHierarchicalColumn.CellTemplate>
                        </DataGridHierarchicalColumn>

                        <DataGridTemplateColumn Header="Size"
                                                Width="90"
                                                CanUserSort="True"
                                                CanUserResize="True"
                                                SortMemberPath="Size"
                                                x:CompileBindings="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock DataContext="{Binding Item}"
                                               Text="{Binding FormattedSize}"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Modified"
                                                Width="130"
                                                CanUserSort="True"
                                                CanUserResize="True"
                                                SortMemberPath="LastModified"
                                                x:CompileBindings="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock DataContext="{Binding Item}"
                                               Text="{Binding FormattedLastModified}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Attributes"
                                                Width="80"
                                                CanUserSort="True"
                                                CanUserResize="True"
                                                SortMemberPath="Attributes"
                                                x:CompileBindings="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock DataContext="{Binding Item}"
                                               Text="{Binding Attributes}"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Source Path"
                                                Width="150"
                                                CanUserSort="True"
                                                CanUserResize="True"
                                                SortMemberPath="FullPath"
                                                x:CompileBindings="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock DataContext="{Binding Item}"
                                               Text="{Binding FullPath}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Destination Path & Format with Browse Destination Button -->
        <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Destination Archive:" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Format:" FontWeight="SemiBold" Margin="8,0,0,0" />

            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding DestinationPath}"
                     PlaceholderText="Destination archive path"
                     Margin="0,6,0,0" />
            <Button Grid.Row="1" Grid.Column="1"
                    Content="Browse..."
                    Command="{Binding BrowseDestinationFileCommand}"
                    Margin="8,6,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="2"
                      ItemsSource="{Binding Formats}"
                      SelectedItem="{Binding SelectedFormat}"
                      Margin="8,6,0,0"
                      HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Modern Compression Preset Cards & Slider -->
        <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorSecondary}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Compression Level:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompressionLevel}" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentRatioEstimate, StringFormat='({0}'}" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{Binding CurrentThroughputEstimate, StringFormat='- {0})'}" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <!-- Dynamic Profile Badge -->
                    <Border Grid.Column="1"
                            Background="{Binding ProfileBadgeColor}"
                            CornerRadius="12"
                            Padding="12,3">
                        <TextBlock Text="{Binding ProfileName}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- Slider with Bi-directional Binding -->
                <Slider Minimum="1"
                        Maximum="22"
                        Value="{Binding CompressionLevel}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />

                <!-- Segmented Preset Cards -->
                <ItemsControl x:Name="PresetCards" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:CompressionPreset">
                            <Button Command="{Binding $parent[ItemsControl].((vm:CompressionSettingsViewModel)DataContext).SelectPresetCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="3"
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    CornerRadius="8">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                        <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondary}">
                                        <Run Text="Ratio: "/><Run Text="{Binding Ratio}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource Icon.Zap}"
                                                  Width="12" Height="12"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorTertiary}" />
                                        <TextBlock Text="{Binding Throughput}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ProfileDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
