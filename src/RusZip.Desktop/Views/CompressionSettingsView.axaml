<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             xmlns:models="using:RusZip.Desktop.Models"
             x:Class="RusZip.Desktop.Views.CompressionSettingsView"
             x:DataType="vm:CompressionSettingsViewModel">

    <StackPanel Spacing="16" Margin="16">
        <!-- Source Path with File and Folder Browse Buttons -->
        <StackPanel Spacing="6">
            <TextBlock Text="Source File / Directory:" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                <TextBox Grid.Row="0" Grid.Column="0"
                         Text="{Binding SourcePath}"
                         PlaceholderText="Select file or directory to compress" />
                <Button Grid.Row="0" Grid.Column="1"
                        Content="Browse File..."
                        Command="{Binding BrowseSourceFileCommand}"
                        Margin="8,0,0,0" />
                <Button Grid.Row="0" Grid.Column="2"
                        Content="Browse Folder..."
                        Command="{Binding BrowseSourceFolderCommand}"
                        Margin="4,0,0,0" />

                <!-- Multi-source staging display (F-27): all dropped non-archive paths are shown
                     when more than one source is staged. -->
                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                            Margin="0,4,0,0"
                            IsVisible="{Binding HasMultipleSources}"
                            Spacing="2">
                    <TextBlock Text="Staged sources:"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondary}" />
                    <ItemsControl x:Name="StagedSources" ItemsSource="{Binding SourcePaths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondary}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Destination Path & Format with Browse Destination Button -->
        <Grid ColumnDefinitions="*,Auto,120" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Destination Archive:" FontWeight="SemiBold" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Format:" FontWeight="SemiBold" Margin="8,0,0,0" />

            <TextBox Grid.Row="1" Grid.Column="0"
                     Text="{Binding DestinationPath}"
                     PlaceholderText="Destination archive path"
                     Margin="0,6,0,0" />
            <Button Grid.Row="1" Grid.Column="1"
                    Content="Browse..."
                    Command="{Binding BrowseDestinationFileCommand}"
                    Margin="8,6,0,0" />
            <ComboBox Grid.Row="1" Grid.Column="2"
                      ItemsSource="{Binding Formats}"
                      SelectedItem="{Binding SelectedFormat}"
                      Margin="8,6,0,0"
                      HorizontalAlignment="Stretch" />
        </Grid>

        <!-- Modern Compression Preset Cards & Slider -->
        <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorSecondary}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Compression Level:" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CompressionLevel}" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentRatioEstimate, StringFormat='({0}'}" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" FontSize="12" />
                        <TextBlock Text="{Binding CurrentThroughputEstimate, StringFormat='- {0})'}" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>

                    <!-- Dynamic Profile Badge -->
                    <Border Grid.Column="1"
                            Background="{Binding ProfileBadgeColor}"
                            CornerRadius="12"
                            Padding="12,3">
                        <TextBlock Text="{Binding ProfileName}"
                                   Foreground="White"
                                   FontSize="11"
                                   FontWeight="Bold" />
                    </Border>
                </Grid>

                <!-- Slider with Bi-directional Binding -->
                <Slider Minimum="1"
                        Maximum="22"
                        Value="{Binding CompressionLevel}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True" />

                <!-- Segmented Preset Cards (F-34: data-driven from PresetProfiles; card visuals
                     unchanged from the previous hardcoded four-card grid) -->
                <ItemsControl x:Name="PresetCards" ItemsSource="{Binding Presets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:CompressionPreset">
                            <Button Command="{Binding $parent[ItemsControl].((vm:CompressionSettingsViewModel)DataContext).SelectPresetCommand}"
                                    CommandParameter="{Binding}"
                                    Margin="3"
                                    Padding="10,8"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    CornerRadius="8">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="13" />
                                        <Border Grid.Column="1" Background="{Binding BadgeColor}" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondary}">
                                        <Run Text="Ratio: "/><Run Text="{Binding Ratio}"/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource Icon.Zap}"
                                                  Width="12" Height="12"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorTertiary}" />
                                        <TextBlock Text="{Binding Throughput}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding ProfileDescription}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
