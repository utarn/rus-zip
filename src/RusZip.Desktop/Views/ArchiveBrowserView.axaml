<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             x:Class="RusZip.Desktop.Views.ArchiveBrowserView"
             x:DataType="vm:ArchiveBrowserViewModel">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- Archive Details and Action Toolbar -->
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorSecondary}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <!-- Top Row: Archive Path + Summary Info -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.FileArchive}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondary}" />
                    <TextBlock Text="Archive:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadedArchivePath}"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalEntries, StringFormat='{}Items: {0:N0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalUncompressedSize, StringFormat='{}Size: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalCompressedSize, StringFormat='{}Compressed: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalRatio, StringFormat='{}Ratio: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                </StackPanel>

                <!-- Bottom Row: Filter Box + Action Buttons -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <TextBox x:Name="FilterTextBox"
                             Grid.Column="0"
                             Width="260"
                             PlaceholderText="Filter contents..."
                             Text="{Binding FilterText, Mode=TwoWay}"
                             VerticalAlignment="Center">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource Icon.Search}" Width="12" Height="12"
                                      VerticalAlignment="Center"
                                      Margin="6,0,0,0"
                                      Foreground="{DynamicResource TextFillColorTertiary}" />
                        </TextBox.InnerLeftContent>
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding ClearFilterCommand}"
                                    IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Padding="4,2"
                                    Margin="0,0,2,0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <PathIcon Data="{StaticResource Icon.Clear}" Width="12" Height="12" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding AppendFilesCommand}"
                            IsVisible="{Binding CanCompress}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.NewArchive}" Width="12" Height="12" />
                            <TextBlock Text="Add Files..." VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectedCommand}"
                            IsVisible="{Binding CanCompress}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            <TextBlock Text="Delete Selected" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExpandAllCommand}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.ExpandAll}" Width="12" Height="12" />
                            <TextBlock Text="Expand All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CollapseAllCommand}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.CollapseAll}" Width="12" Height="12" />
                            <TextBlock Text="Collapse All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RequestExtractCommand}"
                            Classes="accent"
                            Padding="12,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Extract}" Width="12" Height="12" />
                            <TextBlock Text="Extract All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Breadcrumb Navigation Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BreadcrumbItemViewModel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                <Button Command="{Binding NavigateCommand}"
                                        CommandParameter="{Binding FullPath}"
                                        Padding="6,3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource Icon.FileArchive}"
                                                  Width="12" Height="12"
                                                  IsVisible="{Binding IsRoot}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorSecondary}" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="{Binding FontWeight}" />
                                    </StackPanel>
                                </Button>
                                <PathIcon Data="{StaticResource Icon.Chevron}"
                                           Width="12" Height="12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorTertiary}"
                                           Margin="2,0"
                                           IsVisible="{Binding !IsLast}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Empty-State Error Banner (e.g. entry-count cap exceeded) -->
        <Border x:Name="LoadErrorBanner"
                Grid.Row="2"
                IsVisible="{Binding HasLoadError}"
                Background="{DynamicResource SystemFillColorCriticalBackground}"
                BorderBrush="{DynamicResource SystemFillColorCriticalBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Alert}" Width="16" Height="16" Foreground="{DynamicResource SystemFillColorCritical}" />
                <TextBlock Text="{Binding LoadErrorMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemFillColorCritical}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Extraction Guardrail Settings (ADR-0007) -->
        <Border Grid.Row="3"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Extraction limits:"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondary}" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Max size:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBox Text="{Binding ExtractionSettings.MaxUncompressedSizeText}"
                             Width="100"
                             FontSize="12"
                             PlaceholderText="e.g. 64 GB"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Max entries:" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                    <NumericUpDown Value="{Binding ExtractionSettings.MaxEntryCount}"
                                   Minimum="0"
                                   Maximum="2147483647"
                                   Increment="1000"
                                   FormatString="0"
                                   Width="120"
                                   VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="0 = unlimited"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiary}" />
            </StackPanel>
        </Border>

        <!-- Virtualized ProDataGrid (hierarchical) with Context Menu.
             The Name column is a DataGridHierarchicalColumn (renders the hierarchy expander and
             indent; its cell template unwraps HierarchicalNode.Item via Binding="Item"). The
             remaining columns are template columns whose templates also unwrap Item, because the
             grid exposes the row DataContext as the wrapping HierarchicalNode. Columns disable
             compiled bindings (x:CompileBindings=False) since the DataContext is the node wrapper
             at the template root. The column CustomSortComparer instances are plain CLR properties
             that cannot be bound in XAML, so the view code-behind assigns them and forwards each
             column's SortDirection to the direction-aware comparers (directories stay grouped
             above files in both ascending and descending sorts). -->
        <DataGrid x:Name="ArchiveGrid"
                  Grid.Row="4"
                  HierarchicalRowsEnabled="True"
                  HierarchicalModel="{Binding GridSource}"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  HeadersVisibility="Column"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  SelectedItem="{Binding SelectedItem}"
                  SelectionChanged="OnArchiveGridSelectionChanged"
                  CellPointerPressed="OnArchiveGridCellPointerPressed">
            <DataGrid.ContextMenu>
                <ContextMenu Opening="OnArchiveGridContextMenuOpening"
                             Closing="OnArchiveGridContextMenuClosing">
                    <MenuItem Header="Append Files..."
                              Command="{Binding AppendFilesCommand}"
                              IsVisible="{Binding CanCompress}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.NewArchive}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Extract Selected..."
                              Command="{Binding ExtractItemCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Extract}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete Selected"
                              Command="{Binding DeleteSelectedCommand}"
                              IsVisible="{Binding CanCompress}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy Relative Path"
                              Command="{Binding CopyPathCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FileGeneric}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridHierarchicalColumn Header="Name"
                                            Width="*"
                                            CanUserSort="True"
                                            CanUserResize="True"
                                            SortMemberPath="Name"
                                            x:CompileBindings="False"
                                            Binding="{Binding Item}">
                    <DataGridHierarchicalColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{Binding IconGeometry}" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridHierarchicalColumn.CellTemplate>
                </DataGridHierarchicalColumn>

                <DataGridTemplateColumn Header="Size"
                                        Width="110"
                                        CanUserSort="True"
                                        CanUserResize="True"
                                        SortMemberPath="UncompressedSize"
                                        x:CompileBindings="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Item}"
                                       Text="{Binding FormattedUncompressedSize}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Compressed"
                                        Width="110"
                                        CanUserSort="True"
                                        CanUserResize="True"
                                        SortMemberPath="CompressedSize"
                                        x:CompileBindings="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Item}"
                                       Text="{Binding FormattedCompressedSize}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ratio"
                                        Width="80"
                                        CanUserSort="True"
                                        CanUserResize="True"
                                        SortMemberPath="RatioValue"
                                        x:CompileBindings="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Item}"
                                       Text="{Binding FormattedRatio}"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Modified"
                                        Width="140"
                                        CanUserSort="True"
                                        CanUserResize="True"
                                        SortMemberPath="LastModified"
                                        x:CompileBindings="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Item}"
                                       Text="{Binding FormattedLastModified}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Attributes"
                                        Width="90"
                                        CanUserSort="True"
                                        CanUserResize="True"
                                        SortMemberPath="Attributes"
                                        x:CompileBindings="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock DataContext="{Binding Item}"
                                       Text="{Binding Attributes}"
                                       VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
