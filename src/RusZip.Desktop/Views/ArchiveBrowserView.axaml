<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             x:Class="RusZip.Desktop.Views.ArchiveBrowserView"
             x:DataType="vm:ArchiveBrowserViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Archive Details and Action Toolbar -->
        <Border Grid.Row="0"
                Padding="12,8"
                Background="{DynamicResource CardBackgroundFillColorSecondary}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <!-- Top Row: Archive Path + Summary Info -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource Icon.FileArchive}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondary}" />
                    <TextBlock Text="Archive:" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LoadedArchivePath}"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="450" />
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TotalEntries, StringFormat='{}Items: {0:N0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalUncompressedSize, StringFormat='{}Size: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalCompressedSize, StringFormat='{}Compressed: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                    <TextBlock Text="{Binding FormattedTotalRatio, StringFormat='{}Ratio: {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorTertiary}" />
                </StackPanel>

                <!-- Bottom Row: Filter Box + Action Buttons -->
                <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                    <TextBox Grid.Column="0"
                             Width="260"
                             Watermark="Filter contents..."
                             Text="{Binding FilterText, Mode=TwoWay}"
                             VerticalAlignment="Center">
                        <TextBox.InnerRightContent>
                            <Button Command="{Binding ClearFilterCommand}"
                                    IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Padding="4,2"
                                    Margin="0,0,2,0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <PathIcon Data="{StaticResource Icon.Clear}" Width="12" Height="12" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                </Grid>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding ExpandAllCommand}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.ExpandAll}" Width="12" Height="12" />
                            <TextBlock Text="Expand All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CollapseAllCommand}"
                            Padding="10,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.CollapseAll}" Width="12" Height="12" />
                            <TextBlock Text="Collapse All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RequestExtractCommand}"
                            Classes="accent"
                            Padding="12,5"
                            FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Extract}" Width="12" Height="12" />
                            <TextBlock Text="Extract All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Breadcrumb Navigation Bar -->
        <Border Grid.Row="1"
                Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BreadcrumbItemViewModel">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                <Button Command="{Binding NavigateCommand}"
                                        CommandParameter="{Binding FullPath}"
                                        Padding="6,3"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <PathIcon Data="{StaticResource Icon.FileArchive}"
                                                  Width="12" Height="12"
                                                  IsVisible="{Binding IsRoot}"
                                                  VerticalAlignment="Center"
                                                  Foreground="{DynamicResource TextFillColorSecondary}" />
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="{Binding FontWeight}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="›"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorTertiary}"
                                           Margin="2,0"
                                           IsVisible="{Binding !IsLast}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Virtualized TreeDataGrid with Context Menu -->
        <TreeDataGrid Grid.Row="2"
                      Source="{Binding GridSource}"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      ShowColumnHeaders="True">
            <TreeDataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Extract Selected..."
                              Command="{Binding ExtractSelectedItemCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.Extract}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy Relative Path"
                              Command="{Binding CopyPathCommand}">
                        <MenuItem.Icon>
                            <PathIcon Data="{StaticResource Icon.FileGeneric}" Width="14" Height="14" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeDataGrid.ContextMenu>
        </TreeDataGrid>
    </Grid>
</UserControl>
