<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        x:Class="RusZip.Desktop.Views.PasswordPromptDialog"
        x:DataType="vm:PasswordPromptViewModel"
        Title="Password Required - RUS ZIP"
        Icon="avares://RusZip.Desktop/Assets/rus-zip.ico"
        Width="460" Height="280"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="Full"
        Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Custom Title Bar Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.FileArchive}"
                          Width="18" Height="18"
                          Foreground="{DynamicResource SystemAccentColor}" />
                <TextBlock Text="Password Protection"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <StackPanel Grid.Row="1" Margin="20,16" Spacing="12">
            <TextBlock Text="This archive is password-protected. Enter the password to unlock:"
                       TextWrapping="Wrap"
                       FontSize="13" />

            <TextBox x:Name="PasswordInput"
                     Text="{Binding Password}"
                     PasswordChar="*"
                     RevealPassword="{Binding IsPasswordVisible}"
                     PlaceholderText="Archive password"
                     Margin="0,4,0,0" />

            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding ErrorMessage}"
                           Foreground="{DynamicResource SystemFillColorCritical}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Command="{Binding TogglePasswordVisibilityCommand}"
                        Padding="8,4"
                        FontSize="11">
                    <TextBlock Text="Show / Hide Password" FontSize="11" />
                </Button>
            </Grid>
        </StackPanel>

        <!-- Actions Toolbar -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Command="{Binding CancelCommand}"
                        Content="Cancel"
                        Padding="16,7"
                        CornerRadius="6" />
                <Button Command="{Binding SubmitCommand}"
                        Content="Unlock"
                        Classes="accent"
                        Padding="20,7"
                        CornerRadius="6" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
