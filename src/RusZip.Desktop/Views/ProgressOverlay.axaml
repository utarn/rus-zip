<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             xmlns:charts="using:ProCharts.Avalonia"
             x:Class="RusZip.Desktop.Views.ProgressOverlay"
             x:DataType="vm:OperationProgressViewModel"
             IsVisible="{Binding IsOperationRunning}">

    <Grid Background="#7F000000">
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="500"
                Padding="24"
                Background="{DynamicResource SolidBackgroundFillColorBase}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="12"
                BoxShadow="0 12 40 #50000000">

            <StackPanel Spacing="16">
                <!-- Title & Current File -->
                <TextBlock Text="{Binding OperationTitle}"
                           FontSize="18"
                           FontWeight="SemiBold" />

                <TextBlock Text="{Binding CurrentFileName}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />

                <!-- Progress Bar -->
                <ProgressBar Value="{Binding ProgressPercentage}"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Height="8"
                             CornerRadius="4" />

                <!-- Throughput Velocity Chart (ProCharts) -->
                <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6">
                    <charts:ProChartView x:Name="ThroughputChart"
                                         ChartModel="{Binding ThroughputChartModel}"
                                         Height="110"
                                         EnablePanZoom="False"
                                         ShowToolTips="False"
                                         ShowCrosshair="False"
                                         EnableHoverTracking="False"
                                         EnableKeyboardNavigation="False"
                                         MinWindowCount="10" />
                </Border>

                <!-- Metrics Grid: Bytes, Percentage, Speed badge, ETA badge -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding BytesProgressFormatted}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondary}" />

                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                               FontWeight="Bold"
                               FontSize="13" />

                    <!-- Badges Row -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Zap}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="Speed:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="{Binding FormattedSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimary}" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource Icon.Clock}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="ETA:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="{Binding FormattedEta}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Cancel Button -->
                <Button Content="Cancel"
                        HorizontalAlignment="Right"
                        Command="{Binding CancelCommand}"
                        Padding="24,6"
                        Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
