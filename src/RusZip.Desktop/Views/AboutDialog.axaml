<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        x:Class="RusZip.Desktop.Views.AboutDialog"
        x:DataType="vm:AboutViewModel"
        Title="About rus-zip"
        Width="620" Height="540"
        MinWidth="520" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="Full"
        Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Custom Title Bar -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.FileArchive}"
                          Width="16" Height="16"
                          Foreground="{DynamicResource SystemAccentColor}" />
                <TextBlock Text="About rus-zip"
                           FontWeight="SemiBold"
                           FontSize="14"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Body -->
        <ScrollViewer Grid.Row="1" Margin="20,16">
            <StackPanel Spacing="16">
                <!-- App Branding & Summary -->
                <Border Padding="16"
                        CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <Border Grid.Column="0"
                                Width="54" Height="54"
                                CornerRadius="27"
                                Background="{DynamicResource CardBackgroundFillColorDefault}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                BorderThickness="1"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource Icon.FileArchive}"
                                      Width="28" Height="28"
                                      Foreground="{DynamicResource SystemAccentColor}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="rus-zip" FontSize="18" FontWeight="Bold" />
                                <Border Background="{DynamicResource SystemAccentColor}"
                                        CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Version, StringFormat='{}v{0}'}"
                                               FontSize="11" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding BuildInfo}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding LicenseSummary}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Supported Formats Matrix -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Supported Archive Formats Matrix" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorPrimary}" />
                    <Border CornerRadius="8"
                            Background="{DynamicResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            Padding="1">
                        <ItemsControl ItemsSource="{Binding SupportedFormats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:FormatCapabilityItemViewModel">
                                    <Border Padding="10,6" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="140,80,95,140,*">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding PrimaryExtension}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SystemAccentColor}" />
                                                <TextBlock Text="{Binding FormatName}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                    Background="{DynamicResource CardBackgroundFillColorDefault}">
                                                <TextBlock Text="{Binding ReadWriteCapability}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{Binding IsReadWrite, Converter={x:Static ObjectConverters.IsNull}}" />
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{Binding Aliases}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding CompressionEngine}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{Binding CompressionLevels}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Actions Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="16,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Command="{Binding CopyDiagnosticsCommand}"
                        Padding="14,7"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource Icon.FileDoc}" Width="14" Height="14" />
                        <TextBlock Text="{Binding DiagnosticsStatus}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        Classes="accent"
                        Padding="24,7"
                        CornerRadius="6" />
            </Grid>
        </Border>
    </Grid>
</Window>
