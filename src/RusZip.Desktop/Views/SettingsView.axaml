<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RusZip.Desktop.ViewModels"
             x:Class="RusZip.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="16" Margin="16">
        <!-- Section Header -->
        <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="File Associations" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Manage default application and context menu verbs (Extract here, Extract to..., Extract to subfolder) for supported archive formats."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondary}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Command="{Binding LoadAssociationsCommand}"
                            Content="Refresh Status"
                            VerticalAlignment="Center"
                            Padding="12,6" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Formats Checklist Card -->
        <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                Padding="16">
            <StackPanel Spacing="12">
                <!-- Selection Toolbar -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Supported Archive Formats" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Padding="8,4" FontSize="11" />
                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Padding="8,4" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Format list -->
                <ItemsControl ItemsSource="{Binding Formats}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:FormatAssociationItemViewModel">
                            <Border BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                    BorderThickness="0,0,0,1"
                                    Padding="8,8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding Extension}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                    </StackPanel>
                                    <Border Grid.Column="2"
                                            Background="{Binding StatusBadgeColor}"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Status Feedback Message -->
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{DynamicResource SystemAccentColor}"
                           IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
                    <Button Command="{Binding ReapplyAllAssociationsCommand}"
                            Content="Set All as Default"
                            Padding="16,7"
                            CornerRadius="6" />
                    <Button Command="{Binding ApplyAssociationsCommand}"
                            Content="Apply Selected"
                            Classes="accent"
                            Padding="20,7"
                            CornerRadius="6" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
