<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        x:Class="RusZip.Desktop.Views.QuickExtractWindow"
        x:DataType="vm:QuickExtractViewModel"
        Title="Quick Extract - RUS ZIP"
        Width="520" Height="320"
        MinWidth="480" MinHeight="280"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        WindowDecorations="Full"
        Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Title Bar Area -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Extract}" Width="16" Height="16" />
                    <TextBlock Text="Quick Extract" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ArchiveFileName}"
                           Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <!-- State 1: Running Progress State -->
            <StackPanel IsVisible="{Binding IsRunning}" Spacing="12" VerticalAlignment="Center">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentFileName}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}"
                               FontWeight="Bold"
                               FontSize="13" />
                </Grid>

                <ProgressBar Value="{Binding ProgressPercentage}"
                             Minimum="0"
                             Maximum="100"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Height="8"
                             CornerRadius="4" />

                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding BytesProgressFormatted}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondary}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding DestinationDirectory, StringFormat='To: {0}'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiary}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                </Grid>

                <!-- Badges: Speed, ETA, Elapsed -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Zap}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="Speed:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="{Binding FormattedSpeed}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Clock}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="ETA:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="{Binding FormattedEta}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Clock}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="Elapsed:" FontSize="12" Foreground="{DynamicResource TextFillColorTertiary}" />
                            <TextBlock Text="{Binding FormattedElapsedTime}" FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- State 2: Success State -->
            <Border IsVisible="{Binding IsSuccess}"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource Icon.Check}" Width="18" Height="18" Foreground="#107C41" />
                        <TextBlock Text="Extraction Completed" FontWeight="SemiBold" FontSize="15" />
                    </StackPanel>

                    <TextBlock Text="{Binding DestinationDirectory, StringFormat='Extracted to: {0}'}"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               TextTrimming="CharacterEllipsis" />

                    <!-- Metrics Summary Grid -->
                    <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8">
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Files Extracted" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="{Binding FilesExtracted, StringFormat='{}{0:N0}'}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total Size" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="{Binding FormattedTotalSize}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Elapsed Time" FontSize="11" Foreground="{DynamicResource TextFillColorTertiary}" />
                                <TextBlock Text="{Binding FormattedElapsedTime}" FontWeight="SemiBold" FontSize="14" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- State 3: Cancelled State -->
            <StackPanel IsVisible="{Binding IsCancelled}" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <PathIcon Data="{StaticResource Icon.Close}" Width="24" Height="24" Foreground="{DynamicResource TextFillColorSecondary}" />
                <TextBlock Text="Extraction Cancelled" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Text="Temporary files have been cleaned up." FontSize="12" Foreground="{DynamicResource TextFillColorSecondary}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- State 4: Error State -->
            <StackPanel IsVisible="{Binding IsError}" Spacing="8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Data="{StaticResource Icon.Alert}" Width="18" Height="18" Foreground="#D13438" />
                    <TextBlock Text="Extraction Failed" FontWeight="SemiBold" FontSize="14" Foreground="#D13438" />
                </StackPanel>
                <Border Background="{DynamicResource CardBackgroundFillColorSecondary}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,8">
                    <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondary}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Footer / Action Buttons -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <!-- When Running: Cancel button -->
                <Button IsVisible="{Binding IsRunning}"
                        Command="{Binding CancelCommand}"
                        Content="Cancel"
                        HorizontalAlignment="Right"
                        Padding="16,6" />

                <!-- When Success: Open Folder (Left) and Close with Countdown (Right) -->
                <Grid IsVisible="{Binding IsSuccess}" ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Command="{Binding OpenFolderCommand}"
                            Padding="12,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="14" Height="14" />
                            <TextBlock Text="Open Folder" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding CloseCommand}"
                            Content="{Binding AutoCloseButtonText}"
                            Padding="16,6" />
                </Grid>

                <!-- When Cancelled or Error: Close button -->
                <Button IsVisible="{Binding ShowCloseButtonOnly}"
                        Command="{Binding CloseCommand}"
                        Content="Close"
                        HorizontalAlignment="Right"
                        Padding="16,6" />
            </Grid>
        </Border>
    </Grid>
</Window>
