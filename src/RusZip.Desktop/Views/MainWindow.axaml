<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        xmlns:views="using:RusZip.Desktop.Views"
        x:Class="RusZip.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="rus-zip - Compression Suite"
        Width="900" Height="600"
        MinWidth="700" MinHeight="450"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="46"
        WindowDecorations="Full"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        Background="Transparent">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Modern Ribbon / Toolbar & Custom Title Bar -->
        <Border Grid.Row="0"
                x:Name="TitleBarArea"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto" x:Name="TitleBarContentGrid">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding ShowCompressDialogCommand}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.NewArchive}" Width="16" Height="16" />
                            <TextBlock Text="New Archive" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnOpenArchiveClicked"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="16" Height="16" />
                            <TextBlock Text="Open Archive" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Click="OnExtractAllClicked"
                            IsEnabled="{Binding HasOpenArchive}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Extract}" Width="16" Height="16" />
                            <TextBlock Text="Extract All" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CloseArchiveCommand}"
                            IsEnabled="{Binding HasOpenArchive}"
                            Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                            <TextBlock Text="Close" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <!-- Settings Button -->
                    <Button Command="{Binding OpenSettingsCommand}"
                            Padding="10,8"
                            ToolTip.Tip="Settings and File Associations">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Theme Switcher Toggle -->
                    <Button Command="{Binding ToggleThemeCommand}"
                            Padding="10,8"
                            ToolTip.Tip="Toggle Theme (System / Dark / Light)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Panel Width="16" Height="16">
                                <PathIcon Data="{StaticResource Icon.ThemeDark}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding IsDarkTheme}" />
                                <PathIcon Data="{StaticResource Icon.ThemeLight}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding IsLightTheme}" />
                                <PathIcon Data="{StaticResource Icon.ThemeLight}"
                                          Width="16" Height="16"
                                          Opacity="0.7"
                                          IsVisible="{Binding IsSystemTheme}" />
                            </Panel>
                            <TextBlock Text="{Binding ThemeDisplayName}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <!-- Mode 1: Elevated Empty / Drag-and-Drop State Card -->
            <Grid IsVisible="{Binding !HasOpenArchive}" Margin="48,32">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="620"
                        MinWidth="460"
                        Background="{DynamicResource CardBackgroundFillColorDefault}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="16"
                        BoxShadow="0 12 36 #25000000"
                        Padding="40,32">

                    <!-- Inner Region with Dashed Accent Outline and Vector Illustration -->
                    <Grid>
                        <!-- Dashed Accent Border Outline -->
                        <Rectangle Stroke="{DynamicResource SurfaceStrokeColorDefault}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="5,4"
                                   RadiusX="12"
                                   RadiusY="12"
                                   IsHitTestVisible="False"
                                   Margin="-16,-12" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <!-- Vector Icon Illustration Badge -->
                            <Border Width="80" Height="80"
                                    CornerRadius="40"
                                    Background="{DynamicResource CardBackgroundFillColorSecondary}"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.NewArchive}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SystemAccentColor}" />
                            </Border>

                            <!-- Dropzone Instructions -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Drop archive to open or files to create"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Supports .zrus (Tar+Zstd), .zip, .rar, .7z, .gz, .tar.gz"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondary}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Drag-Over Visual Feedback Badge -->
                            <Border IsVisible="{Binding IsDragOver}"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="8"
                                    Padding="16,6"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="Drop files here to open or compress"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold" />
                            </Border>

                            <!-- Quick-Action Chips -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <!-- Open Archive Chip Button -->
                                <Button Click="OnOpenArchiveClicked"
                                        Command="{Binding OpenArchivePickerCommand}"
                                        Padding="16,8"
                                        CornerRadius="20">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="16" Height="16" />
                                        <TextBlock Text="Open Archive" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Create Archive / New Archive Chip Button -->
                                <Button Command="{Binding CreateArchiveCommand}"
                                        Padding="16,8"
                                        CornerRadius="20"
                                        Classes="accent">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="16" Height="16" />
                                        <TextBlock Text="Create Archive" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mode 2: Archive Browser -->
            <views:ArchiveBrowserView DataContext="{Binding Browser}"
                                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasOpenArchive}" />
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackgroundFillColorSecondary}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondary}" />
        </Border>

        <!-- Mode 3: Compress Dialog Overlay (spans entire window for true modal backdrop and top z-index) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" IsVisible="{Binding IsCompressDialogVisible}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="780"
                    Height="580"
                    MinWidth="680"
                    MinHeight="480"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 16 48 #50000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.NewArchive}" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Create Archive" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseCompressDialogCommand}" Padding="8,4">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <views:CompressionSettingsView DataContext="{Binding Settings}" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,14" Background="{DynamicResource CardBackgroundFillColorSecondary}" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="Cancel" Command="{Binding CloseCompressDialogCommand}" Padding="16,7" CornerRadius="6" />
                            <Button Content="Compress" Command="{Binding ExecuteCompressCommand}" Classes="accent" Padding="22,7" CornerRadius="6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Mode 4: Progress Overlay (spans entire window for true modal backdrop and top z-index) -->
        <views:ProgressOverlay Grid.Row="0" Grid.RowSpan="3" DataContext="{Binding Progress}" />

        <!-- Mode 5: Settings Dialog Overlay (spans entire window for true modal backdrop and top z-index) -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#7F000000" IsVisible="{Binding IsSettingsDialogVisible}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620"
                    MaxHeight="540"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 16 48 #50000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Settings}" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseSettingsDialogCommand}" Padding="8,4">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="4">
                        <views:SettingsView DataContext="{Binding SettingsViewModel}" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorSecondary}" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="Close" Command="{Binding CloseSettingsDialogCommand}" Padding="18,6" CornerRadius="6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
