<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RusZip.Desktop.ViewModels"
        xmlns:views="using:RusZip.Desktop.Views"
        x:Class="RusZip.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="RUS ZIP - Compression Suite"
        Icon="avares://RusZip.Desktop/Assets/rus-zip.ico"
        Width="900" Height="600"
        MinWidth="700" MinHeight="450"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"
        WindowDecorations="Full"
        TransparencyLevelHint="Mica, AcrylicBlur, Blur"
        Background="Transparent">

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Archive..." Command="{Binding CreateArchiveCommand}" Gesture="Ctrl+N" />
                        <NativeMenuItem Header="Open Archive..." Command="{Binding OpenArchivePickerCommand}" Gesture="Ctrl+O" />
                        <NativeMenuItem Header="Recent Archives">
                            <NativeMenuItem.Menu>
                                <NativeMenu>
                                    <NativeMenuItem Header="(No Recent Archives)" IsEnabled="False" />
                                </NativeMenu>
                            </NativeMenuItem.Menu>
                        </NativeMenuItem>
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Close Archive" Command="{Binding CloseArchiveCommand}" IsEnabled="{Binding HasOpenArchive}" Gesture="Ctrl+W" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit" Command="{Binding ExitApplicationCommand}" Gesture="Alt+F4" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Edit">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Select All" Command="{Binding SelectAllCommand}" Gesture="Ctrl+A" />
                        <NativeMenuItem Header="Invert Selection" Command="{Binding InvertSelectionCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Copy Relative Path" Command="{Binding CopyRelativePathCommand}" Gesture="Ctrl+C" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Delete Selected" Command="{Binding DeleteSelectedCommand}" Gesture="Delete" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="View">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Refresh" Command="{Binding RefreshArchiveCommand}" Gesture="F5" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Expand All" Command="{Binding ExpandAllCommand}" Gesture="Ctrl+Shift+E" />
                        <NativeMenuItem Header="Collapse All" Command="{Binding CollapseAllCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Focus Filter" Command="{Binding FocusFilterCommand}" Gesture="Ctrl+F" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Archive">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Add Files / Append..." Command="{Binding AppendFilesCommand}" Gesture="Ctrl+Shift+A" />
                        <NativeMenuItem Header="Extract All" Command="{Binding ExtractAllMenuCommand}" Gesture="Ctrl+E" />
                        <NativeMenuItem Header="Extract Selected..." Command="{Binding ExtractSelectedItemCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Test Archive" Command="{Binding TestArchiveCommand}" Gesture="Ctrl+T" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Properties" Command="{Binding ShowPropertiesCommand}" Gesture="Alt+Enter" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Tools">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Settings..." Command="{Binding OpenSettingsCommand}" Gesture="Ctrl+OemComma" />
                        <NativeMenuItem Header="Theme Switcher" Command="{Binding ToggleThemeCommand}" />
                        <NativeMenuItem Header="File Associations..." Command="{Binding OpenFileAssociationsCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Help">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Documentation" Command="{Binding OpenDocumentationCommand}" />
                        <NativeMenuItem Header="Supported Formats" Command="{Binding OpenSupportedFormatsCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="About RUS ZIP" Command="{Binding ShowAboutCommand}" Gesture="F1" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding CreateArchiveCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenArchivePickerCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseArchiveCommand}" />
        <KeyBinding Gesture="Alt+F4" Command="{Binding ExitApplicationCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyRelativePathCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Gesture="F5" Command="{Binding RefreshArchiveCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+E" Command="{Binding ExpandAllCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusFilterCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+A" Command="{Binding AppendFilesCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExtractAllMenuCommand}" />
        <KeyBinding Gesture="Ctrl+T" Command="{Binding TestArchiveCommand}" />
        <KeyBinding Gesture="Alt+Enter" Command="{Binding ShowPropertiesCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ShowAboutCommand}" />
    </Window.KeyBindings>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{DynamicResource SolidBackgroundFillColorBase}">
        <!-- Compact Toolbar & Custom Title Bar (~36px) -->
        <Border Grid.Row="0"
                x:Name="TitleBarArea"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="8,2"
                Height="36"
                PointerPressed="OnTitleBarPointerPressed">
            <Grid ColumnDefinitions="*,Auto" x:Name="TitleBarContentGrid">
                <!-- Primary Actions -->
                <StackPanel Grid.Column="0"
                            x:Name="PrimaryToolbarButtons"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <Button x:Name="NewArchiveButton"
                            Command="{Binding ShowCompressDialogCommand}"
                            Padding="6,5"
                            ToolTip.Tip="New Archive (Ctrl+N)">
                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="OpenArchiveButton"
                            Click="OnOpenArchiveClicked"
                            Padding="6,5"
                            ToolTip.Tip="Open Archive (Ctrl+O)">
                        <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="ExtractAllButton"
                            Click="OnExtractAllClicked"
                            IsEnabled="{Binding HasOpenArchive}"
                            Padding="6,5"
                            ToolTip.Tip="Extract All (Ctrl+E)">
                        <PathIcon Data="{StaticResource Icon.Extract}" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="AppendFilesButton"
                            Command="{Binding AppendFilesCommand}"
                            IsEnabled="{Binding CanAppendToArchive}"
                            Padding="6,5"
                            ToolTip.Tip="Add to Archive (Ctrl+Shift+A)">
                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="DeleteSelectedButton"
                            Command="{Binding DeleteSelectedCommand}"
                            IsEnabled="{Binding CanDeleteFromArchive}"
                            Padding="6,5"
                            ToolTip.Tip="Delete Selected (Delete)">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                    </Button>

                    <Button x:Name="CloseArchiveButton"
                            Command="{Binding CloseArchiveCommand}"
                            IsEnabled="{Binding HasOpenArchive}"
                            Padding="6,5"
                            ToolTip.Tip="Close Archive (Ctrl+W)">
                        <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                    </Button>
                </StackPanel>

                <!-- Trailing / Utility Actions & Overflow -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center">
                    <StackPanel x:Name="TrailingToolbarButtons"
                                Orientation="Horizontal"
                                Spacing="4">
                        <!-- Settings Button -->
                        <Button x:Name="SettingsButton"
                                Command="{Binding OpenSettingsCommand}"
                                Padding="6,5"
                                ToolTip.Tip="Settings (Ctrl+,)">
                            <PathIcon Data="{StaticResource Icon.Settings}" Width="16" Height="16" />
                        </Button>

                        <!-- Theme Switcher Toggle -->
                        <Button x:Name="ThemeButton"
                                Command="{Binding ToggleThemeCommand}"
                                Padding="6,5"
                                ToolTip.Tip="{Binding ThemeDisplayName, StringFormat='Theme: {0}'}">
                            <Panel Width="16" Height="16">
                                <PathIcon Data="{StaticResource Icon.ThemeDark}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding IsDarkTheme}" />
                                <PathIcon Data="{StaticResource Icon.ThemeLight}"
                                          Width="16" Height="16"
                                          IsVisible="{Binding IsLightTheme}" />
                                <PathIcon Data="{StaticResource Icon.ThemeLight}"
                                          Width="16" Height="16"
                                          Opacity="0.7"
                                          IsVisible="{Binding IsSystemTheme}" />
                            </Panel>
                        </Button>
                    </StackPanel>

                    <!-- Overflow Button (⋯) with Flyout -->
                    <Button x:Name="ToolbarOverflowButton"
                            Padding="6,5"
                            ToolTip.Tip="More Actions"
                            IsVisible="False">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="New Archive..."
                                          Command="{Binding ShowCompressDialogCommand}"
                                          InputGesture="Ctrl+N">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Open Archive..."
                                          Command="{Binding OpenArchivePickerCommand}"
                                          InputGesture="Ctrl+O">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extract All"
                                          Command="{Binding ExtractAllMenuCommand}"
                                          IsEnabled="{Binding HasOpenArchive}"
                                          InputGesture="Ctrl+E">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.Extract}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Add to Archive..."
                                          Command="{Binding AppendFilesCommand}"
                                          IsEnabled="{Binding CanAppendToArchive}"
                                          InputGesture="Ctrl+Shift+A">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Delete Selected"
                                          Command="{Binding DeleteSelectedCommand}"
                                          IsEnabled="{Binding CanDeleteFromArchive}"
                                          InputGesture="Delete">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Close Archive"
                                          Command="{Binding CloseArchiveCommand}"
                                          IsEnabled="{Binding HasOpenArchive}"
                                          InputGesture="Ctrl+W">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Settings..."
                                          Command="{Binding OpenSettingsCommand}"
                                          InputGesture="Ctrl+,">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.Settings}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Toggle Theme"
                                          Command="{Binding ToggleThemeCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon Data="{StaticResource Icon.ThemeLight}" Width="14" Height="14" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <PathIcon Data="{StaticResource Icon.More}" Width="16" Height="16" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Top-Level Application Menu Bar -->
        <Border Grid.Row="1"
                x:Name="AppMenuBarBorder"
                Background="{DynamicResource CardBackgroundFillColorDefault}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,0,0,1"
                Padding="6,2">
            <Menu x:Name="AppMenuBar">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Archive..." Command="{Binding CreateArchiveCommand}" InputGesture="Ctrl+N" />
                    <MenuItem Header="_Open Archive..." Command="{Binding OpenArchivePickerCommand}" InputGesture="Ctrl+O" />
                    <MenuItem Header="_Recent Archives" ItemsSource="{Binding RecentArchives}" IsEnabled="{Binding HasRecentArchives}">
                        <MenuItem.Styles>
                            <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecentArchiveItemViewModel">
                                <Setter Property="Header" Value="{Binding FileName}" />
                                <Setter Property="Command" Value="{Binding OpenCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding FullPath}" />
                                <Setter Property="ToolTip.Tip" Value="{Binding FullPath}" />
                            </Style>
                        </MenuItem.Styles>
                    </MenuItem>
                    <MenuItem Header="Clear Recent Archives" Command="{Binding ClearRecentArchivesCommand}" IsEnabled="{Binding HasRecentArchives}" />
                    <Separator />
                    <MenuItem Header="_Close Archive" Command="{Binding CloseArchiveCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+W" />
                    <Separator />
                    <MenuItem Header="E_xit" Command="{Binding ExitApplicationCommand}" InputGesture="Alt+F4" />
                </MenuItem>
                <MenuItem Header="_Edit">
                    <MenuItem Header="Select _All" Command="{Binding SelectAllCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+A" />
                    <MenuItem Header="_Invert Selection" Command="{Binding InvertSelectionCommand}" IsEnabled="{Binding HasOpenArchive}" />
                    <Separator />
                    <MenuItem Header="_Copy Relative Path" Command="{Binding CopyRelativePathCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+C" />
                    <Separator />
                    <MenuItem Header="_Delete Selected" Command="{Binding DeleteSelectedCommand}" IsEnabled="{Binding CanDeleteFromArchive}" InputGesture="Delete" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="_Refresh" Command="{Binding RefreshArchiveCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="F5" />
                    <Separator />
                    <MenuItem Header="_Expand All" Command="{Binding ExpandAllCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+Shift+E" />
                    <MenuItem Header="_Collapse All" Command="{Binding CollapseAllCommand}" IsEnabled="{Binding HasOpenArchive}" />
                    <Separator />
                    <MenuItem Header="_Focus Filter" Command="{Binding FocusFilterCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+F" />
                </MenuItem>
                <MenuItem Header="_Archive">
                    <MenuItem Header="_Add Files / Append..." Command="{Binding AppendFilesCommand}" IsEnabled="{Binding CanAppendToArchive}" InputGesture="Ctrl+Shift+A" />
                    <MenuItem Header="_Extract All" Command="{Binding ExtractAllMenuCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+E" />
                    <MenuItem Header="Extract _Selected..." Command="{Binding ExtractSelectedItemCommand}" IsEnabled="{Binding HasOpenArchive}" />
                    <Separator />
                    <MenuItem Header="_Test Archive" Command="{Binding TestArchiveCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Ctrl+T" />
                    <Separator />
                    <MenuItem Header="_Properties" Command="{Binding ShowPropertiesCommand}" IsEnabled="{Binding HasOpenArchive}" InputGesture="Alt+Enter" />
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="_Settings..." Command="{Binding OpenSettingsCommand}" InputGesture="Ctrl+," />
                    <MenuItem Header="_Theme Switcher" Command="{Binding ToggleThemeCommand}" />
                    <MenuItem Header="_File Associations..." Command="{Binding OpenFileAssociationsCommand}" />
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_Documentation" Command="{Binding OpenDocumentationCommand}" />
                    <MenuItem Header="_Supported Formats" Command="{Binding OpenSupportedFormatsCommand}" />
                    <Separator />
                    <MenuItem Header="_About RUS ZIP" Command="{Binding ShowAboutCommand}" InputGesture="F1" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- Mode 1: Elevated Empty / Drag-and-Drop State Card -->
            <Grid IsVisible="{Binding !HasOpenArchive}" Margin="48,32">
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="620"
                        MinWidth="460"
                        Background="{DynamicResource CardBackgroundFillColorDefault}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        CornerRadius="16"
                        BoxShadow="0 12 36 #25000000"
                        Padding="40,32">

                    <!-- Inner Region with Dashed Accent Outline and Vector Illustration -->
                    <Grid>
                        <!-- Dashed Accent Border Outline -->
                        <Rectangle Stroke="{DynamicResource SurfaceStrokeColorDefault}"
                                   StrokeThickness="1.5"
                                   StrokeDashArray="5,4"
                                   RadiusX="12"
                                   RadiusY="12"
                                   IsHitTestVisible="False"
                                   Margin="-16,-12" />

                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                            <!-- Vector Icon Illustration Badge -->
                            <Border Width="80" Height="80"
                                    CornerRadius="40"
                                    Background="{DynamicResource CardBackgroundFillColorSecondary}"
                                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon.NewArchive}"
                                          Width="40" Height="40"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource SystemAccentColor}" />
                            </Border>

                            <!-- Dropzone Instructions -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <TextBlock Text="Drop archive to open or files to create"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Supports .zrus (Tar+Zstd), .zip, .rar, .7z, .gz, .tar.gz"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondary}"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Drag-Over Visual Feedback Badge -->
                            <Border IsVisible="{Binding IsDragOver}"
                                    Background="{DynamicResource SystemAccentColor}"
                                    CornerRadius="8"
                                    Padding="16,6"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="Drop files here to open or compress"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold" />
                            </Border>

                            <!-- Quick-Action Chips -->
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <!-- Open Archive Chip Button -->
                                <Button Click="OnOpenArchiveClicked"
                                        Command="{Binding OpenArchivePickerCommand}"
                                        Padding="16,8"
                                        CornerRadius="20">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.OpenFolder}" Width="16" Height="16" />
                                        <TextBlock Text="Open Archive" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Create Archive / New Archive Chip Button -->
                                <Button Command="{Binding CreateArchiveCommand}"
                                        Padding="16,8"
                                        CornerRadius="20"
                                        Classes="accent">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource Icon.NewArchive}" Width="16" Height="16" />
                                        <TextBlock Text="Create Archive" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Recent Archives Quick Launch Section -->
                            <StackPanel IsVisible="{Binding HasRecentArchives}" Spacing="10" Margin="0,12,0,0">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="Recent Archives" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextFillColorSecondary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding ClearRecentArchivesCommand}" Background="Transparent" BorderThickness="0" Padding="4,2">
                                        <TextBlock Text="Clear" FontSize="11" Foreground="{DynamicResource SystemAccentColor}" />
                                    </Button>
                                </Grid>
                                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding RecentArchives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:RecentArchiveItemViewModel">
                                                <Border Margin="0,3" Padding="8,6" CornerRadius="8"
                                                        Background="{DynamicResource CardBackgroundFillColorSecondary}"
                                                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                                        <Border Grid.Column="0" CornerRadius="4" Padding="5,2" Margin="0,0,8,0"
                                                                Background="{DynamicResource SystemAccentColor}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding ExtensionBadge}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>
                                                        <Button Grid.Column="1" Command="{Binding OpenCommand}" CommandParameter="{Binding FullPath}"
                                                                Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding DirectoryName}" FontSize="10" Foreground="{DynamicResource TextFillColorTertiary}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Grid.Column="2" Command="{Binding RemoveCommand}" CommandParameter="{Binding FullPath}"
                                                                Background="Transparent" BorderThickness="0" Padding="4" ToolTip.Tip="Remove from recent history">
                                                            <PathIcon Data="{StaticResource Icon.Close}" Width="10" Height="10" Opacity="0.6" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Mode 2: Archive Browser -->
            <views:ArchiveBrowserView x:Name="BrowserView"
                                      DataContext="{Binding Browser}"
                                      IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasOpenArchive}" />
        </Grid>

        <!-- 3-Segment Status Bar -->
        <Border Grid.Row="3"
                Background="{DynamicResource CardBackgroundFillColorSecondary}"
                BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <!-- Segment 1: Operational Status (Left) -->
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Segment 2: Selection Metrics (Middle) -->
                <Border Grid.Column="1"
                        Margin="16,0"
                        Padding="8,1"
                        CornerRadius="4"
                        Background="{DynamicResource CardBackgroundFillColorDefault}"
                        BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                        BorderThickness="1"
                        IsVisible="{Binding HasOpenArchive}">
                    <TextBlock Text="{Binding SelectionMetricsText}"
                               FontSize="11"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextFillColorSecondary}"
                               VerticalAlignment="Center" />
                </Border>

                <!-- Segment 3: Format & Guardrail Badges (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Padding="6,1"
                            CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefault}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            IsVisible="{Binding FormatCapabilityBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding FormatCapabilityBadge}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SystemAccentColor}"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Padding="6,1"
                            CornerRadius="4"
                            Background="{DynamicResource CardBackgroundFillColorDefault}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                            BorderThickness="1"
                            IsVisible="{Binding GuardrailLimitBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{Binding GuardrailLimitBadge}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiary}"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode 3: Compress Dialog Overlay (spans entire window for true modal backdrop and top z-index) -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" IsVisible="{Binding IsCompressDialogVisible}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="780"
                    Height="580"
                    MinWidth="680"
                    MinHeight="480"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 16 48 #50000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.NewArchive}" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Create Archive" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseCompressDialogCommand}" Padding="8,4">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1">
                        <views:CompressionSettingsView DataContext="{Binding Settings}" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,14" Background="{DynamicResource CardBackgroundFillColorSecondary}" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="Cancel" Command="{Binding CloseCompressDialogCommand}" Padding="16,7" CornerRadius="6" />
                            <Button Content="Compress" Command="{Binding ExecuteCompressCommand}" Classes="accent" Padding="22,7" CornerRadius="6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Mode 4: Progress Overlay (spans entire window for true modal backdrop and top z-index) -->
        <views:ProgressOverlay Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding Progress}" />

        <!-- Mode 5: Settings Dialog Overlay (spans entire window for true modal backdrop and top z-index) -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Background="#7F000000" IsVisible="{Binding IsSettingsDialogVisible}">
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="620"
                    MaxHeight="540"
                    Background="{DynamicResource CardBackgroundFillColorDefault}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefault}"
                    BorderThickness="1"
                    CornerRadius="12"
                    BoxShadow="0 16 48 #50000000">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Border Grid.Row="0" Padding="20,14" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{StaticResource Icon.Settings}" Width="18" Height="18" VerticalAlignment="Center" />
                                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Command="{Binding CloseSettingsDialogCommand}" Padding="8,4">
                                <PathIcon Data="{StaticResource Icon.Close}" Width="12" Height="12" />
                            </Button>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="4">
                        <views:SettingsView DataContext="{Binding SettingsViewModel}" />
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,12" Background="{DynamicResource CardBackgroundFillColorSecondary}" BorderBrush="{DynamicResource SurfaceStrokeColorDefault}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <Button Content="Close" Command="{Binding CloseSettingsDialogCommand}" Padding="18,6" CornerRadius="6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
