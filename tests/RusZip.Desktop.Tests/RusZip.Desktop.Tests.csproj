<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>RusZip.Desktop.Tests</RootNamespace>
    <!-- xUnit1051 (new xunit v3 analyzer): advises TestContext.Current.CancellationToken over
         CancellationToken.None in tests. Suppressed to keep the pre-existing test call sites
         unchanged during the xunit v2 -> v3 migration. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- xunit v3 (Avalonia.Headless.XUnit 12.x is built against xunit v3, so all test projects
         use xunit.v3 for a single consistent test framework). -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RusZip.Desktop\RusZip.Desktop.csproj" />
    <ProjectReference Include="..\..\src\RusZip.Core\RusZip.Core.csproj" />
    <ProjectReference Include="..\RusZip.Core.Tests\RusZip.Core.Tests.csproj" />
  </ItemGroup>

</Project>
