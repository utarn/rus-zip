<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>RusZip.Core.Tests</RootNamespace>
    <!-- xUnit1051 (new xunit v3 analyzer): advises TestContext.Current.CancellationToken over
         CancellationToken.None in tests. Suppressed to keep the pre-existing test call sites
         unchanged during the xunit v2 -> v3 migration. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RusZip.Core\RusZip.Core.csproj" />
  </ItemGroup>

</Project>